{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Offline Intelligence",
    "version": "0.1.0",
    "identifier": "com.offline-intelligence.app",
    "build": {
        "beforeDevCommand": "",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420"
    },
    "app": {
        "windows": [
            {
                "title": "Offline Intelligence",
                "width": 800,
                "height": 600,
                "transparent": false,
                "decorations": true,
                "resizable": true,
                "fullscreen": false,
                "hiddenTitle": false,
                "titleBarStyle": "Visible"
            }
        ],
        "security": {
            "csp": null,
            "capabilities": [
                {
                    "identifier": "main-capability",
                    "windows": ["main"],
                    "permissions": [
                        "core:default",
                        "shell:default",
                        "dialog:default",
                        "fs:default",
                        "fs:allow-write-text-file",
                        "dialog:allow-save"
                    ]
                }
            ]
        },
        "macOSPrivateApi": false
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.ico"
        ]
    }
}