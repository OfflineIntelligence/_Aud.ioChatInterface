#!/bin/bash

# _Aud.io Pre-Commit Hook
# Runs tests before allowing commits to ensure code quality

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}🔍 Running pre-commit tests...${NC}"
echo ""

# Get the project root
PROJECT_ROOT=$(git rev-parse --show-toplevel)

# Run Rust tests
echo -e "${YELLOW}Testing Rust backend...${NC}"
cd "$PROJECT_ROOT/crates/offline-intelligence"

# Run config tests specifically (fastest smoke test)
if ! cargo test config::tests --lib --quiet 2>&1; then
    echo -e "${RED}✗ Rust tests failed!${NC}"
    echo ""
    echo "To skip this check, run: git commit --no-verify"
    exit 1
fi

echo -e "${GREEN}✓ Rust tests passed${NC}"
echo ""

# Run cargo check for all targets
echo -e "${YELLOW}Checking Rust code...${NC}"
if ! cargo check --all --quiet 2>&1; then
    echo -e "${RED}✗ Cargo check failed!${NC}"
    exit 1
fi

echo -e "${GREEN}✓ Cargo check passed${NC}"
echo ""

# Check TypeScript if frontend code changed
if git diff --cached --name-only | grep -q "apps/desktop/src"; then
    echo -e "${YELLOW}TypeScript files detected, checking frontend...${NC}"
    
    if command -v npm &> /dev/null; then
        cd "$PROJECT_ROOT/apps/desktop"
        
        # Install dependencies if needed
        if [ ! -d "node_modules" ]; then
            npm install --legacy-peer-deps > /dev/null 2>&1
        fi
        
        # Run type check
        if ! npm run build --quiet 2>&1; then
            echo -e "${RED}✗ Frontend build failed!${NC}"
            exit 1
        fi
        
        echo -e "${GREEN}✓ Frontend build passed${NC}"
    fi
fi

echo ""
echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
echo ""

exit 0
