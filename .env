#####################################################
# GPU Configuration - HARDCODED
#####################################################
GPU_LAYERS=16
CTX_SIZE=32768
BATCH_SIZE=128
THREADS=6

#####################################################
# Model & Server Paths
#####################################################
# MODEL_PATH: Set this to your model file, or leave commented for auto-detection
# The app will search for models in Resources/models/ directory
# MODEL_PATH="D:/_Aud.io-ChatInterface/crates/offline-intelligence/Resources/models/gguf-model.gguf"

# LLAMA_BIN: Optional override - if not set, auto-detects based on OS:
#   Windows: Resources/bin/Windows/*/llama-server.exe
#   macOS:   Resources/bin/MacOS/*/llama-server
#   Linux:   Resources/bin/Linux/*/llama-server
# Uncomment only for development with a specific path:
# LLAMA_BIN="D:/_Aud.io-ChatInterface/crates/offline-intelligence/Resources/bin/Windows/llama-b6970-bin-win-cuda-12.4-x64/llama-server.exe"

#####################################################
# Network Configuration
#####################################################
API_HOST=127.0.0.1
API_PORT=8000
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8001

#####################################################
# Performance & Timeout Settings
#####################################################
MAX_CONCURRENT_STREAMS=2
HOT_SWAP_GRACE_SECONDS=25
HEALTH_TIMEOUT_SECONDS=600
HEALTH_CHECK_TIMEOUT_SECONDS=900
GENERATE_TIMEOUT_SECONDS=300
STREAM_TIMEOUT_SECONDS=600

#####################################################
# Monitoring & Logging
#####################################################
PROMETHEUS_PORT=9000
REQUESTS_PER_SECOND=24
RUST_LOG=info,axum=info,tower_http=info

#####################################################
# SMTP Configuration (for feedback emails)
#####################################################
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=product@offlineintelligence.io
SMTP_PASS=Omnamashiva1!*

MMPROJ_PATH=none
ENABLE_MULTIMODAL=false
USE_CLIP=false

#####################################################
# HuggingFace Authentication (Optional)
#####################################################
# HF_TOKEN: Required for downloading gated/private models from HuggingFace
# Get your token from: https://huggingface.co/settings/tokens
# Without this token, you may encounter 401 errors for some models
# and will be rate limited to 100 requests/hour
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#####################################################
# OpenRouter API Configuration (Optional)
#####################################################
# OPENROUTER_API_KEY: Required for using OpenRouter models
# Get your API key from: https://openrouter.ai/keys
# Without this key, OpenRouter models will be displayed but cannot be used
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx